# Common kernel options for Penguin Patcher
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_NVME_CORE=y
CONFIG_NVME_FABRICS=y
CONFIG_NVME_FC=y
CONFIG_NVME_TCP=y
CONFIG_NVME_APPLE=y
CONFIG_DRM_APPLE=y
CONFIG_WIFI=y
CONFIG_WLAN=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_USB=y
CONFIG_BT=y
CONFIG_BT_HCIBCM4377=m
CONFIG_SND_SOC_APPLE_MCA=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_TYPEC_UCSI_APPLE=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_GPIO_MACSMC=y
CONFIG_THERMAL=y
CONFIG_APPLE_MBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
